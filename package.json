{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "description": "A web-search chat agent with a dated claims ledger: it remembers what it told you and re-checks it.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "mcp": "tsx src/mcp.ts",
    "eval": "tsx eval/run.ts",
    "eval:live": "tsx eval/live.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/openai": "^4.0.115",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.170",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "luxon": "^3.7.2",
    "marked": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
