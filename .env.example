# ── Required ────────────────────────────────────────────────────────────────
# Web search. Free tier: https://app.tavily.com
TAVILY_API_KEY=

# A model API key: set ONE of these three. The provider is picked
# automatically from whichever key is present (or force it with LLM_PROVIDER).
# Google Gemini, free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# google | openai | anthropic
# LLM_PROVIDER=
# Model for answers and fact comparison (sensible default per provider)
# MAIN_MODEL=
# Model for routing and memory extraction (sensible default per provider)
# FAST_MODEL=
# PORT=3000
# MEMORY_FILE=./data/memory.json
# Used when the browser does not send its timezone
# DEFAULT_TIMEZONE=Asia/Kolkata
# Lets the UI set the agent's clock, to test "last Tuesday"-style questions
# ALLOW_TIME_TRAVEL=true
